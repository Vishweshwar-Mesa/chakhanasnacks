{% comment %}
  Renders a whole-number discount percentage, e.g. "18" for an 18% cut.
  Renders nothing if compare_at_price isn't actually higher than price.

  Accepts:
  - compare_at_price: {Number} the "was" price
  - price: {Number} the current price

  Usage:
  {% render 'discount-percent', compare_at_price: variant.compare_at_price, price: variant.price %}
{% endcomment %}
{%- if compare_at_price > price -%}
  {{- compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round -}}
{%- endif -%}
