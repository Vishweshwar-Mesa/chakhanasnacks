{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .chk-story {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .chk-story {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-6);
    }

    .chk-story--reverse .chk-story__media {
      order: 2;
    }
  }

  .chk-story__media {
    position: relative;
  }

  .chk-story__media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-editorial);
  }

  .chk-story__badge {
    position: absolute;
    top: -1.6rem;
    right: -1.6rem;
    width: 8.8rem;
    height: 8.8rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1.15;
    text-transform: uppercase;
    padding: var(--space-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .chk-story__badge {
      animation: chk-spin 18s linear infinite;
    }
  }

  @keyframes chk-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .chk-story__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .chk-story__stat-value {
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: 2.6rem;
    display: block;
  }

  .chk-story__stat-label {
    opacity: 0.7;
    font-size: 1.3rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="chk-story{% if section.settings.layout == 'reverse' %} chk-story--reverse{% endif %}">
      <div class="chk-story__media chk-reveal">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag: loading: 'lazy', widths: '450, 675, 900', sizes: '(min-width: 750px) 40vw, 90vw', alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- endif -%}
        {%- if section.settings.badge_text != blank -%}
          <span class="chk-story__badge color-{{ section.settings.badge_color_scheme }}">{{ section.settings.badge_text }}</span>
        {%- endif -%}
      </div>
      <div class="chk-reveal" style="--chk-stagger: 1;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="chk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="chk-display chk-display--lg">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="chk-lede rte" style="margin-top: var(--space-3);">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="chk-story__stats">
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>
                <span class="chk-story__stat-value">{{ block.settings.value }}</span>
                <span class="chk-story__stat-label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="button" style="margin-top: var(--space-4);">
            {{ section.settings.link_label | default: 'Shop Makhana' }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "default",
      "options": [
        { "value": "default", "label": "Image left" },
        { "value": "reverse", "label": "Image right" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Fried fresh, never boring" },
    { "type": "color_scheme", "id": "badge_color_scheme", "label": "Badge color", "default": "scheme-6" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The makhana story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not your dadi's boring plain makhana" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Makhana (fox nuts) have been a snack cupboard staple forever — usually plain, usually forgotten halfway through the bowl. We fry ours properly and season them like a real snack, in flavours worth reaching for again.</p>"
    },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop Makhana Chips" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "50g / 100g" },
        { "type": "text", "id": "label", "label": "Label", "default": "Resealable pouches" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Makhana story",
      "settings": {
        "eyebrow": "The makhana story",
        "heading": "Not your dadi's boring plain makhana",
        "badge_text": "Fried fresh, never boring",
        "badge_color_scheme": "scheme-6",
        "link_label": "Shop Makhana Chips"
      },
      "blocks": [
        { "type": "stat", "settings": { "value": "4", "label": "Flavours" } },
        { "type": "stat", "settings": { "value": "50g / 100g", "label": "Pack sizes" } }
      ]
    },
    {
      "name": "Ragi story",
      "settings": {
        "layout": "reverse",
        "color_scheme": "scheme-5",
        "eyebrow": "Ragi, reintroduced",
        "heading": "Replacing your boring ragi chips",
        "badge_text": "Your millet snack, minus the boring",
        "badge_color_scheme": "scheme-4",
        "text": "<p>Ragi (finger millet) chips had a reputation problem: healthy, sure, but forgettable. We kept the ragi, ditched the boring — seasoned generously, built for the 4pm crunch craving.</p>",
        "link_label": "Shop Ragi Chips"
      },
      "blocks": [
        { "type": "stat", "settings": { "value": "2", "label": "Flavours" } },
        { "type": "stat", "settings": { "value": "50g / 100g", "label": "Pack sizes" } }
      ]
    }
  ]
}
{% endschema %}
