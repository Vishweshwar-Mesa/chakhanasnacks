{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .section-{{ section.id }} .chk-marquee__item {
    font-family: var(--font-heading-family);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: {{ section.settings.font_size }}px;
    white-space: nowrap;
  }

  .section-{{ section.id }} .chk-marquee__divider {
    width: {{ section.settings.font_size | divided_by: 8.0 }}px;
    height: {{ section.settings.font_size | divided_by: 8.0 }}px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .chk-marquee__item {
      font-size: {{ section.settings.font_size | times: 0.5 }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="chk-marquee" role="group" aria-label="{{ section.settings.aria_label | default: 'Brand marquee' | escape }}">
    {%- capture marquee_items -%}
      {%- for block in section.blocks -%}
        <span class="chk-marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
        <span class="chk-marquee__divider" aria-hidden="true"></span>
      {%- endfor -%}
    {%- endcapture -%}
    <div class="chk-marquee__track">
      {{ marquee_items }}
      {{ marquee_items }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Text size",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible label",
      "default": "Brand marquee"
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "MAKHANA"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "word", "settings": { "text": "MAKHANA" } },
        { "type": "word", "settings": { "text": "CRUNCH" } },
        { "type": "word", "settings": { "text": "MASALA" } },
        { "type": "word", "settings": { "text": "PERI PERI" } },
        { "type": "word", "settings": { "text": "CHAKHANA" } }
      ]
    }
  ]
}
{% endschema %}
