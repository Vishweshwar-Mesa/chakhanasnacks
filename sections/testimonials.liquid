{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .chk-testimonial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 24rem;
    padding: var(--space-4);
    border-radius: var(--radius-editorial);
    background: rgb(var(--color-background));
    box-shadow: var(--shadow-pop);
  }

  .chk-testimonial-card__stars {
    display: flex;
    gap: 0.2rem;
    margin-bottom: var(--space-2);
  }

  .chk-testimonial-card__stars svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
    color: #f2a93e;
  }

  .chk-testimonial-card__quote {
    font-size: 1.8rem;
    line-height: 1.4;
    margin: 0;
  }

  .chk-testimonial-card__author {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: 1.3rem;
  }

  .chk-testimonial-card__author-name {
    font-weight: 700;
  }

  .chk-testimonial-card__demo-tag {
    opacity: 0.55;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="title-wrapper-with-link title-wrapper--no-top-margin chk-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="chk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="title chk-display chk-display--lg">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <slider-component class="slider-mobile-gutter">
      <ul class="grid grid--1-col-tablet-down grid--3-col-desktop slider slider--tablet grid--peek chk-reveal" id="Slider-{{ section.id }}" role="list">
        {%- for block in section.blocks -%}
          <li class="grid__item slider__slide">
            <div class="chk-testimonial-card" {{ block.shopify_attributes }}>
              <div>
                <div class="chk-testimonial-card__stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.rating -%}
                      {{- 'icon-star.svg' | inline_asset_content -}}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="chk-testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
              </div>
              <div class="chk-testimonial-card__author">
                <span class="chk-testimonial-card__author-name">{{ block.settings.name | escape }}</span>
                <span class="chk-testimonial-card__demo-tag">{{ block.settings.demo_tag | default: 'Demo review' }}</span>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.blocks.size > 3 -%}
        <div class="slider-buttons">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Word on the street" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "People who've chakha-ed" },
    {
      "type": "paragraph",
      "content": "These are demo/placeholder reviews so the section can ship today. Swap in real reviews here once you have them, or connect a reviews app."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Genuinely can't stop at one pouch. The masala flavour is unreal." },
        { "type": "text", "id": "name", "label": "Name", "default": "Demo reviewer" },
        { "type": "text", "id": "demo_tag", "label": "Small label", "info": "Keep this as \"Demo review\" until you add a real one.", "default": "Demo review" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "quote": "Genuinely can't stop at one pouch. The masala flavour is unreal.", "name": "Demo reviewer" } },
        { "type": "review", "settings": { "rating": 5, "quote": "Cream & Onion disappeared from my desk in one sitting. No regrets.", "name": "Demo reviewer" } },
        { "type": "review", "settings": { "rating": 4, "quote": "Peri Peri lives up to \"bhaiya thoda aur teekha.\" Respect.", "name": "Demo reviewer" } }
      ]
    }
  ]
}
{% endschema %}
