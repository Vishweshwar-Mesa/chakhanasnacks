{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .chk-box-builder__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  @media screen and (min-width: 750px) {
    .chk-box-builder__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }

  .chk-box-card {
    border-radius: var(--radius-editorial);
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.03);
  }

  .chk-box-card__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .chk-box-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .chk-box-card--sold-out .chk-box-card__media img {
    filter: grayscale(1);
    opacity: 0.5;
  }

  .chk-box-card--sold-out .chk-box-card__name {
    opacity: 0.6;
  }

  .chk-box-card__body {
    padding: var(--space-3);
  }

  .chk-box-card__name {
    font-size: 1.6rem;
    margin: 0 0 var(--space-2);
  }

  .chk-box-card__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.6rem 0;
  }

  .chk-box-card__row + .chk-box-card__row {
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .chk-box-card__row-label {
    font-size: 1.3rem;
    opacity: 0.85;
  }

  .chk-box-card__price {
    display: block;
    font-size: 1.1rem;
    opacity: 0.6;
  }

  .chk-box-stepper {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .chk-box-stepper button {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chk-box-stepper button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .chk-box-stepper__qty {
    min-width: 1.6rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .chk-box-builder__summary {
    position: sticky;
    bottom: var(--space-3);
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-editorial);
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    box-shadow: var(--shadow-pop);
  }

  .chk-box-builder__tier-message {
    font-size: 1.4rem;
    font-weight: 600;
  }

  .chk-box-builder__add {
    white-space: nowrap;
  }
{%- endstyle -%}

<box-builder class="color-{{ section.settings.color_scheme }} gradient" data-tier2-qty="2" data-tier2-pct="5" data-tier4-qty="4" data-tier4-pct="10">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="chk-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="chk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="chk-display chk-display--lg">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="chk-lede rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="chk-box-builder__grid">
      {%- for product in section.settings.products -%}
        <div class="chk-box-card{% unless product.available %} chk-box-card--sold-out{% endunless %}">
          <div class="chk-box-card__media">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', alt: '' }}
            {%- endif -%}
          </div>
          <div class="chk-box-card__body">
            <h3 class="chk-box-card__name">{{ product.title | remove: ' Chips' | escape }}</h3>
            {%- for variant in product.variants -%}
              <div class="chk-box-card__row">
                <span class="chk-box-card__row-label">
                  {{ variant.title }}
                  {%- if variant.available -%}
                    <span class="chk-box-card__price">{{ variant.price | money }}</span>
                  {%- else -%}
                    <span class="chk-box-card__price">Sold out</span>
                  {%- endif -%}
                </span>
                {%- if variant.available -%}
                  <div class="chk-box-stepper" data-variant-row data-variant-id="{{ variant.id }}" data-variant-price="{{ variant.price }}">
                    <button type="button" data-decrement aria-label="Remove one {{ product.title | escape }} {{ variant.title }}">−</button>
                    <span class="chk-box-stepper__qty" data-qty>0</span>
                    <button type="button" data-increment aria-label="Add one {{ product.title | escape }} {{ variant.title }}">+</button>
                  </div>
                {%- else -%}
                  <div class="chk-box-stepper chk-box-stepper--disabled" aria-hidden="true">
                    <button type="button" disabled>−</button>
                    <span class="chk-box-stepper__qty">0</span>
                    <button type="button" disabled>+</button>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="chk-box-builder__summary">
      <span class="chk-box-builder__tier-message" data-tier-message>Pick 2 pouches for 5% off, or 4 for 10% off</span>
      <button type="button" class="button chk-box-builder__add" data-add-to-cart disabled>
        Add box to cart — <span data-total-price>{{ 0 | money }}</span>
      </button>
    </div>
  </div>
</box-builder>

<script src="{{ 'chakhana-box-builder.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Build Your Box",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mix & match" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your own box" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pick any flavours you want. 2 pouches gets you 5% off, 4 gets you 10% off — automatically, at checkout.</p>"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Flavours to include"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Build Your Box"
    }
  ]
}
{% endschema %}
