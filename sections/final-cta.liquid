{%- style -%}
  .section-{{ section.id }} {
    position: relative;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .chk-final-cta__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .chk-final-cta__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
  }

  .chk-final-cta__content {
    position: relative;
    z-index: 1;
    max-width: 70rem;
    margin: 0 auto;
  }

  .chk-final-cta__heading {
    font-size: clamp(3.6rem, 6vw + 1.6rem, 8rem);
  }

  .chk-final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
{%- endstyle -%}

<div class="section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.background_image != blank -%}
    <div class="chk-final-cta__bg" aria-hidden="true">
      {{ section.settings.background_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: '' }}
    </div>
  {%- endif -%}
  <div class="page-width chk-final-cta__content chk-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <span class="chk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    <h2 class="chk-display chk-final-cta__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="chk-lede" style="margin: var(--space-3) auto 0;">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="chk-final-cta__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="button button--secondary">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Final CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Okay." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ab chakh ke dekh." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Crunchy makhana chips, seasoned properly. Free shipping above the threshold in your cart settings.</p>" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop Chakhana" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Final CTA"
    }
  ]
}
{% endschema %}
