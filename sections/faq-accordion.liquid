{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .chk-faq-list {
    max-width: 76rem;
    margin: var(--space-4) auto 0;
  }

  .chk-faq-item {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .chk-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    cursor: pointer;
    font-size: 1.8rem;
    font-weight: 600;
    list-style: none;
  }

  .chk-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .chk-faq-item summary svg {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chk-faq-item summary svg {
      transition: transform var(--duration-fast) var(--ease-standard);
    }
  }

  .chk-faq-item[open] summary svg {
    transform: rotate(180deg);
  }

  .chk-faq-item__content {
    padding-bottom: var(--space-3);
    opacity: 0.8;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="chk-reveal" style="text-align: center;">
        {%- if section.settings.eyebrow != blank -%}
          <span class="chk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="chk-display chk-display--lg">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="chk-faq-list chk-reveal">
      {%- for block in section.blocks -%}
        <details class="chk-faq-item" {{ block.shopify_attributes }}>
          <summary>
            {{ block.settings.question | escape }}
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="chk-faq-item__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions? Answered." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How spicy is the Peri Peri flavour?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Noticeably spicier than Masala — built for people who ask for extra chilli.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
