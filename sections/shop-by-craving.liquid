{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .chk-craving-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media screen and (min-width: 750px) {
    .chk-craving-grid {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, 1fr);
      gap: var(--space-4);
    }
  }

  .chk-craving-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 42rem;
    border-radius: var(--radius-editorial);
    overflow: hidden;
    padding: var(--space-4);
    isolation: isolate;
  }

  .chk-craving-card__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .chk-craving-card__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chk-craving-card__bg img {
      transition: transform var(--duration-slow) var(--ease-out-expo);
    }

    .chk-craving-card:hover .chk-craving-card__bg img,
    .chk-craving-card:focus-visible .chk-craving-card__bg img {
      transform: scale(1.08);
    }
  }

  .chk-craving-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.55) 100%);
    z-index: -1;
  }

  .chk-craving-card__eyebrow {
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.25);
  }

  .chk-craving-card__title {
    color: #fff;
    font-size: clamp(2.4rem, 2vw + 1.8rem, 3.4rem);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.25);
    margin: 0 0 var(--space-2);
  }

  .chk-craving-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .chk-craving-card__link svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chk-craving-card__link svg {
      transition: transform var(--duration-fast) var(--ease-out-expo);
    }

    .chk-craving-card:hover .chk-craving-card__link svg {
      transform: translateX(0.4rem);
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin chk-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="chk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="title chk-display chk-display--lg">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="chk-craving-grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="chk-craving-card chk-focusable chk-reveal"
          style="--chk-stagger: {{ forloop.index0 }};"
          {{ block.shopify_attributes }}
        >
          <span class="chk-craving-card__bg">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '450, 675, 900, 1200', sizes: '(min-width: 750px) 33vw, 100vw', alt: ''
              }}
            {%- endif -%}
          </span>
          <span class="chk-craving-card__scrim" aria-hidden="true"></span>
          {%- if block.settings.tag != blank -%}
            <span class="chk-craving-card__eyebrow chk-eyebrow">{{ block.settings.tag | escape }}</span>
          {%- endif -%}
          <span class="chk-craving-card__title chk-display">{{ block.settings.title | escape }}</span>
          <span class="chk-craving-card__link">
            {{ block.settings.link_label | default: 'Shop now' }}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by craving",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pick your crunch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by craving"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Craving card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Small tag", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Makhana Chips" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by craving",
      "blocks": [
        { "type": "card", "settings": { "tag": "01", "title": "Makhana Chips", "link_label": "Shop Makhana" } },
        { "type": "card", "settings": { "tag": "02", "title": "Ragi Chips", "link_label": "Shop Ragi" } },
        { "type": "card", "settings": { "tag": "03", "title": "Combo Packs", "link_label": "Shop combos" } }
      ]
    }
  ]
}
{% endschema %}
