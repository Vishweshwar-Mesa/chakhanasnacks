{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .chk-ugc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  @media screen and (min-width: 750px) {
    .chk-ugc-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
    }
  }

  .chk-ugc-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 1.6rem;
    overflow: hidden;
    display: block;
  }

  .chk-ugc-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chk-ugc-tile img {
      transition: transform var(--duration-base) var(--ease-out-expo);
    }

    .chk-ugc-tile:hover img,
    .chk-ugc-tile:focus-visible img {
      transform: scale(1.06);
    }
  }

  .chk-ugc-tile__icon {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chk-ugc-tile__icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="title-wrapper-with-link title-wrapper--no-top-margin chk-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="chk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="title chk-display chk-display--lg">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.instagram_handle != blank -%}
        <a href="https://instagram.com/{{ section.settings.instagram_handle | remove: '@' }}" class="link underlined-link" target="_blank" rel="noopener">
          @{{ section.settings.instagram_handle | remove: '@' }}
        </a>
      {%- endif -%}
    </div>

    <div class="chk-ugc-grid chk-reveal">
      {%- for block in section.blocks -%}
        {%- assign tile_tag = 'div' -%}
        {%- if block.settings.link != blank -%}{%- assign tile_tag = 'a' -%}{%- endif -%}
        <{{ tile_tag }}
          {% if block.settings.link != blank %}
            href="{{ block.settings.link }}" target="_blank" rel="noopener"
          {% endif %}
          class="chk-ugc-tile{% if tile_tag == 'a' %} chk-focusable{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 500
              | image_tag: loading: 'lazy', widths: '250, 375, 500', sizes: '(min-width: 750px) 25vw, 50vw', alt: ''
            }}
          {%- endif -%}
          <span class="chk-ugc-tile__icon" aria-hidden="true">{{ 'icon-instagram.svg' | inline_asset_content }}</span>
        </{{ tile_tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "UGC grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "As seen on your feed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Snack of choice" },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram handle",
      "info": "Shown as a link only. To auto-pull live posts, connect an Instagram feed app from the Shopify App Store and swap this section's images for that app's embed block — not built here to avoid a fake/broken integration."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC grid",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
