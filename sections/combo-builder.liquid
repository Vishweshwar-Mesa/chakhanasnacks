{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .chk-combo {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: center;
    border-radius: var(--radius-editorial);
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
  }

  @media screen and (min-width: 750px) {
    .chk-combo {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
  }

  .chk-combo__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .chk-combo__content {
    padding: var(--space-4);
  }

  @media screen and (min-width: 750px) {
    .chk-combo__content {
      padding: var(--space-6);
    }
  }

  .chk-combo__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 var(--space-4);
  }

  .chk-combo__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .chk-combo__price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="chk-combo chk-reveal">
      <div class="chk-combo__media">
        {%- if section.settings.product != blank and section.settings.product.featured_image != blank -%}
          {{
            section.settings.product.featured_image
            | image_url: width: 900
            | image_tag: loading: 'lazy', widths: '450, 675, 900', sizes: '(min-width: 750px) 45vw, 100vw', alt: section.settings.product.title | escape
          }}
        {%- elsif section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag: loading: 'lazy', widths: '450, 675, 900', sizes: '(min-width: 750px) 45vw, 100vw', alt: section.settings.heading | escape
          }}
        {%- endif -%}
      </div>
      <div class="chk-combo__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="chk-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="chk-display chk-display--lg">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="chk-lede rte" style="margin: var(--space-2) 0 var(--space-3);">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="chk-combo__chips">
            {%- for block in section.blocks -%}
              <span class="chk-combo__chip color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
                {{ block.settings.flavour }}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.product != blank -%}
          <div class="chk-combo__price-row">
            {%- render 'price', product: section.settings.product, use_variant: true -%}
          </div>
          <a href="{{ section.settings.product.url }}" class="button">
            {{ section.settings.link_label | default: 'Shop the sampler' }}
          </a>
        {%- elsif section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="button">
            {{ section.settings.link_label | default: 'Shop the sampler' }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Combo builder",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Can't decide?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your crunch" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>All four Chakhana makhana flavours in one pack. The easiest way to find your favourite — spoiler, you'll like all four.</p>"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Sampler product",
      "info": "Price and \"shop\" link pull live from this product. If you haven't imported/published a sampler product yet, set a fallback image + link below instead."
    },
    { "type": "image_picker", "id": "image", "label": "Fallback image (used if no product selected)" },
    { "type": "url", "id": "link", "label": "Fallback link (used if no product selected)" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop the sampler" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "flavour_chip",
      "name": "Flavour chip",
      "settings": [
        { "type": "text", "id": "flavour", "label": "Flavour", "default": "Masala" },
        { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combo builder",
      "blocks": [
        { "type": "flavour_chip", "settings": { "flavour": "Masala", "color_scheme": "scheme-3" } },
        { "type": "flavour_chip", "settings": { "flavour": "Peri Peri", "color_scheme": "scheme-4" } },
        { "type": "flavour_chip", "settings": { "flavour": "Cream & Onion", "color_scheme": "scheme-5" } },
        { "type": "flavour_chip", "settings": { "flavour": "Jain Masala", "color_scheme": "scheme-6" } }
      ]
    }
  ]
}
{% endschema %}
