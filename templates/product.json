{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "ingredients_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Ingredients & storage",
            "icon": "leaf",
            "content": "<p>Made with fried makhana (fox nuts) or ragi (finger millet), a seasoning blend, and edible oil. Full ingredient list and nutritional information are printed on pack.</p><p>Store in a cool, dry place away from direct sunlight. Reseal the pouch after opening to keep the crunch.</p>"
          }
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "truck",
            "content": "<p>We ship pan-India. As this is a food product, we're unable to accept returns once a pack has been opened — message us if anything arrives damaged and we'll sort it out.</p>"
          }
        },
        "nutrition_facts": {
          "type": "nutrition_facts",
          "settings": {
            "heading": "Nutrition & ingredients"
          }
        },
        "faq_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Questions? Answered.",
            "icon": "chat_bubble",
            "content": "<p><strong>How spicy is this?</strong> Check the flavour name — Peri Peri packs the most heat, Masala is chatpata-medium, Cream & Onion and Cheese & Herbs are mild.</p><p><strong>Which size should I get?</strong> 50g is a quick solo craving; 100g is for sharing (or not).</p><p><strong>How long does a pack stay fresh once opened?</strong> Reseal the pouch tightly and finish within a few days for the best crunch.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "ingredients_tab",
        "shipping_tab",
        "nutrition_facts",
        "faq_tab",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
